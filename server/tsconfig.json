{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "../dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "paths": {
      "@server/*": ["./*"],
      "@/*": ["../app/src/*"],
      "@prisma/*": ["../prisma/*"],
      "@shared/*": ["../shared/*"]
    },
    "types": ["bun-types"]
  },
  "include": ["./**/*", "../shared/**/*", "../app/src/vite-env.d.ts", "../dist"],
  "exclude": ["node_modules", "../dist"]
} 