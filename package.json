{
  "name": "blinko-monorepo",
  "version": "1.8.9",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": ["esbuild", "sqlite3"],
  "workspaces": [
    "app",
    "server",
    "shared",
    "app/tauri-plugin-blinko"
  ],
  "scripts": {
    "dev": "cd app && bun run tauri dev",
    "build:web": "turbo run build:web",
    "test": "turbo run test",
    "start:server:production": "ncp dist/public server/public && cd server && bun run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:backend": "dotenv turbo run dev --filter=@blinko/backend",
    "dev:frontend": "dotenv turbo run dev --filter=@blinko/frontend",
    "postinstall": "bun run prisma:generate",
    "setup": "bun install",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma.config.ts",
    "build:seed": "tsup prisma/seed.ts --outDir dist --format esm --target node26 --external @prisma/client --external @prisma/adapter-pg --external pg --external pg-connection-string",
    "seed": "bun dist/seed.js",
    "build:blinko:types": "tsc -p tsconfig.blinko.json"
  },
  "overrides": {
    "xmldom": "npm:@xmldom/xmldom@0.9.12",
    "basic-ftp": "6.2.6",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.13.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "lru-cache": "^11.5.3",
    "react-i18next": "^18.0.1",
    "react-simple-pull-to-refresh": "^1.3.4",
    "wait-on": "^9.5.1"
  },
  "patchedDependencies": {
    "xtraverse@0.1.0": "patches/xtraverse@0.1.0.patch",
    "passport-twitter@1.0.4": "patches/passport-twitter@1.0.4.patch",
    "@shadergradient/react@2.4.20": "patches/@shadergradient%2Freact@2.4.20.patch"
  }
}
