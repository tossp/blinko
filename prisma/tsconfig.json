{
  "compilerOptions": {
    "target": "ES2023",
    "types": ["node", "bun-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".."
  },
  "include": ["./**/*"]
} 